NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/hairstudio
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=30d

GEMINI_API_KEY=your-gemini-api-key

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

REVENUECAT_WEBHOOK_TOKEN=your-revenuecat-webhook-token
SUPPORT_ADJUSTMENT_TOKEN=your-support-adjustment-token
CRON_SECRET=your-cron-secret
AI_BENCHMARK_RUN_TOKEN=your-ai-benchmark-run-token

# Optional benchmark/provider fallbacks
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
AI_BENCHMARK_USE_PRODUCTION_SAMPLES=false
AI_BENCHMARK_JUDGE_MODEL=gemini-2.5-flash
AI_BENCHMARK_BASELINE_MODEL=gemini-2.5-flash-image
AI_BENCHMARK_STANDARD_CREDITS=1
AI_BENCHMARK_PREMIUM_CREDITS=2
AI_BENCHMARK_TARGET_GROSS_MARGIN=0.65